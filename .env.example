# Agent Monitor Configuration
#
# Copy this file to .env and fill in your values.
# All config is via environment variables - no hardcoded personal data.

# SSH target machine where the agent runs
AGENT_MONITOR_SSH_HOST=root@example.com

# SSH private key path (default: ~/.ssh/id_rsa)
AGENT_MONITOR_SSH_KEY=~/.ssh/id_rsa

# Local port for the dashboard (default: 5656)
AGENT_MONITOR_PORT=5656

# Remote repo path (optional - auto-detected from agent process CWD if not set)
# AGENT_MONITOR_REPO_PATH=/root/my-project

# Agent harness to monitor (default: devin)
# Supported: devin
# Future: claude, codex, opencode
# AGENT_MONITOR_HARNESS=devin

# Max log lines to fetch per poll (default: 300)
# AGENT_MONITOR_MAX_LOG_LINES=300
